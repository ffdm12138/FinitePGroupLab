#!/bin/sh
set -eu
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
elif [ -x "/c/ProgramData/miniconda3/python.exe" ]; then
  PY="/c/ProgramData/miniconda3/python.exe"
else
  echo "Python interpreter not found for pre-commit audit." >&2
  exit 1
fi
exec "$PY" scripts/audit_release.py --staged
